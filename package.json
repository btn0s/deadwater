{
  "name": "deadwater",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "audio:audition": "node scripts/build-audio-audition.mjs",
    "audio:build": "node scripts/build-deadwater-audio.mjs",
    "audio:stage-candidates": "node scripts/stage-audio-candidates.mjs",
    "audio:tag-scene": "node scripts/tag-scene-acoustics.mjs",
    "test:audio-audition": "node scripts/test-audio-audition.mjs",
    "test:audio": "node scripts/test-audio-audition.mjs && node scripts/test-audio-catalog.mjs && node scripts/test-acoustics.mjs",
    "test:audio:browser": "node scripts/test-audio-browser.mjs",
    "test:interaction:browser": "node scripts/test-interaction-browser.mjs",
    "test:audio:production": "npm run build && node scripts/test-audio-browser.mjs --production",
    "validate:skills": "node scripts/validate-deadwater-skills.mjs",
    "test:skills": "node scripts/test-deadwater-skills.mjs",
    "test:skills:browser": "node scripts/test-deadwater-browser.mjs",
    "inspect:canvas": "node .agents/skills/deadwater-qa-release/scripts/inspect-deadwater-canvas.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.12.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "leva": "^0.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
